!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

supabase_json_*/
recordings*.json
tracks*.json
releases*.json

#Temp files
.tmp/
tmp/

# Temporary AI output
*.tmp.md
*.draft.md
*.bak.md
*.old.md

# Local notes
notes/
scratch/

.vercel

# Script run artifacts, plus three directories that hold files belonging to
# other work entirely (a visa form, a paint-assignment spreadsheet, a face
# detection model). They arrived in a single bulk write on 2026-08-22 and are
# not Mangulina's; they are ignored here so they stop cluttering git status,
# but they are worth deleting from the working tree.
/models
/output
/outputs
/rebuild_recordings_resume.json
/recordings_failures.log

# Local-only ingest tooling, kept out of the repo the same way /steps,
# /scripts and /backups are. ingest.ts imports entirely from ./steps, and the
# only consumer of mbResolver is steps/4_recordings.ts, so committing these
# would add files whose imports are absent from a fresh clone.
# src/lib/index.ts is listed by exact path only because it is the barrel that
# re-exports mbResolver; drop this entry if src/lib ever needs a real barrel.
/ingest.ts
/utils.ts
/recoverArtists.ts
/recoverArtistsFromTitles.ts
/src/lib/index.ts
/src/lib/mbResolver.ts

# Abandoned shadcn/ui scaffolding: nothing in the app imports either file.
/components.json
/src/components/ui/use-mobile.tsx

# Instagram engagement worker runtime state.
# .instagram-profile holds a real logged-in Chrome session (cookies) and must
# never be committed. logs/ is per-machine run output. The activity history in
# data/ carries only public post URLs, so it is left tracked on purpose: it is
# the worker's memory and is worth keeping across clones.
/.instagram-profile/
/logs/
/data/*.corrupt-*
