        {
          "text": " y ",
          "type": "text"
        },
        {
          "type": "artistReference",
          "attrs": {
            "artistId": "8c784f57-4ee4-41b5-b140-c45d0da1c5f6",
            "displayText": "Joseíto Mateo",
            "occurrenceId": "ff47f3d7-2134-4ba8-bc0a-ea77ba0ede54"
