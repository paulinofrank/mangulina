  "functions": [
    {
      "proname": "get_artist_credited_works_with_roles",
      "definition": "CREATE OR REPLACE FUNCTION public.get_artist_credited_works_with_roles(p_artist_id uuid)\n RETURNS TABLE(id uuid, title text, performer_artist_id uuid, performer_text text, performer_artist_slug text, performer_artist_name text, release_title text, release_type text, release_year integer, label text, track_number text, source_confidence text, roles text[], created_at timestamp with time zone)\n LANGUAGE sql\n STABLE\n SET search_path TO 'public'\nAS $function$\r\n  SELECT\r\n    cw.id,\r\n    cw.title,\r\n    cw.performer_artist_id,\r\n    cw.performer_text,\r\n    performer_artist.slug,\r\n    performer_artist.name,\r\n    cw.release_title,\r\n    NULL::text AS release_type,\r\n    cw.release_year,\r\n    NULL::text AS label,\r\n    NULL::text AS track_number,\r\n    NULL::text AS source_confidence,\r\n    ARRAY_AGG(cwc.role ORDER BY cwc.role) AS roles,\r\n    cw.created_at\r\n  FROM public.credited_works cw\r\n  INNER JOIN public.credited_work_credits cwc ON cwc.credited_work_id = cw.id\r\n  LEFT JOIN public.artists performer_artist ON performer_artist.id = cw.performer_artist_id\r\n  WHERE cwc.artist_id = p_artist_id\r\n  GROUP BY cw.id, performer_artist.id\r\n  ORDER BY cw.release_year DESC NULLS LAST, cw.title ASC;\r\n$function$\n"
    },
    {
      "proname": "get_artist_discography",
      "definition": "CREATE OR REPLACE FUNCTION public.get_artist_discography(artist_uuid uuid)\n RETURNS TABLE(release_id uuid, release_title text, release_year integer, release_type text, track_id uuid, disc_number integer, track_number integer, recording_id uuid, recording_title text, duration_ms integer, genre text, subgenre text, recording_context text)\n LANGUAGE sql\n STABLE\n SET search_path TO 'public', 'extensions'\nAS $function$with ranked_releases as (\r\n  select\r\n    rel.*,\r\n    row_number() over (\r\n      partition by coalesce(rel.release_group_id, rel.id)\r\n      order by\r\n        case\r\n          when rel.country = 'DO' then 0\r\n          when rel.country = 'XW' then 1\r\n          when rel.country is null then 2\r\n          else 3\r\n        end,\r\n        rel.date nulls last,\r\n        rel.created_at\r\n    ) as rn\r\n  from public.releases rel\r\n  where rel.release_artist_id = artist_uuid\r\n    and exists (\r\n      select 1\r\n      from public.artists a\r\n      where a.id = artist_uuid\r\n        and a.status = 'published'\r\n    )\r\n),\r\n\r\nselected_releases as (\r\n  select *\r\n  from ranked_releases\r\n  where rn = 1\r\n)\r\n\r\nselect\r\n  rel.id as release_id,\r\n  coalesce(rg.title, rel.title) as release_title,\r\n\r\n  coalesce(\r\n    rg.release_year,\r\n    rel.release_year,\r\n    rel.year\r\n  ) as release_year,\r\n\r\n  coalesce(\r\n    rg.primary_type,\r\n    rel.type,\r\n    rel.metadata #>> '{release-group,primary-type}'\r\n  ) as release_type,\r\n\r\n  t.id as track_id,\r\n  coalesce(t.disc_number, 1) as disc_number,\r\n  coalesce(t.position, t.track_number) as track_number,\r\n\r\n  r.id as recording_id,\r\n  coalesce(t.title_override, r.title) as recording_title,\r\n\r\n  coalesce(t.length, r.duration) as duration_ms,\r\n\r\n  g.name as genre,\r\n  sg.name as subgenre,\r\n\r\n  r.recording_context\r\n\r\nfrom selected_releases rel\r\n\r\nleft join public.release_groups rg\r\n  on rg.id = rel.release_group_id\r\n\r\njoin public.tracks t\r\n  on t.release_id = rel.id\r\n\r\njoin public.recordings r\r\n  on r.id = t.recording_id\r\n\r\nleft join public.genres g\r\n  on g.id = r.genre_id\r\n\r\nleft join public.genres sg\r\n  on sg.id = r.subgenre_id\r\n\r\norder by\r\n  coalesce(rg.release_year, rel.release_year, rel.year) nulls last,\r\n  coalesce(rg.title, rel.title),\r\n  coalesce(t.disc_number, 1),\r\n  coalesce(t.position, t.track_number);$function$\n"
    },
    {
      "proname": "get_artist_song_discography",
      "definition": "CREATE OR REPLACE FUNCTION public.get_artist_song_discography(artist_uuid uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n SELECT coalesce(jsonb_agg(to_jsonb(s) ORDER BY s.year NULLS LAST, s.title, s.id), '[]'::jsonb)\n FROM public.public_song_recordings s\n WHERE EXISTS (SELECT 1 FROM public.artists a WHERE a.id = artist_uuid AND a.status = 'published')\n AND (s.artist_id = artist_uuid OR EXISTS (\n   SELECT 1 FROM public.recording_credits c WHERE c.recording_id = s.id AND c.artist_id = artist_uuid\n   AND c.role IN ('lead_performer','featured_performer','guest_performer','vocalist','performer','featured_artist')\n ));\n$function$\n"
    }
  ]
