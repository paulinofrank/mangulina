{
  "name": "mangulina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/dev-watchpack.cjs ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "audit-db-health": "tsx scripts/auditDatabaseHealth.ts",
    "instagram:worker": "tsx scripts/instagram/runEngagementWorker.ts",
    "instagram:worker:dry": "tsx scripts/instagram/runEngagementWorker.ts --dry-run",
    "instagram:verify-selectors": "tsx scripts/instagram/verifyDriverAgainstFixtures.ts",
    "instagram:typecheck": "tsc --noEmit -p tsconfig.instagram.json",
    "instagram:sign-in": "tsx scripts/instagram/signIn.ts",
    "instagram:next": "tsx scripts/instagram/queue.ts next",
    "instagram:record": "tsx scripts/instagram/queue.ts record",
    "instagram:status": "tsx scripts/instagram/queue.ts status",
    "instagram:chrome": "tsx scripts/instagram/launchChrome.ts",
    "instagram:digest": "tsx scripts/instagram/runDigest.ts",
    "instagram:ack": "tsx scripts/instagram/acknowledge.ts",
    "revalidate": "tsx scripts/revalidate.ts"
  },
  "dependencies": {
    "@fontsource/finlandica": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.106.1",
    "@swc/core": "^1.15.33",
