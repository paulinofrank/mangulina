    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.1",
    "next-intl": "^4.13.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "sharp": "^0.35.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20.19.40",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  },
